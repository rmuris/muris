generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Driver {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?
  licenseNo    String     @unique
  status       String     @default("AVAILABLE") // AVAILABLE | ON_ROUTE | OFF_DUTY
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  vehicle      Vehicle?
  shipments    Shipment[]
}

model Vehicle {
  id           String     @id @default(cuid())
  plate        String     @unique
  make         String
  model        String
  year         Int
  capacity     Float      // tons
  status       String     @default("AVAILABLE") // AVAILABLE | IN_USE | MAINTENANCE
  mileage      Int        @default(0)
  lastService  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  driverId     String?    @unique
  driver       Driver?    @relation(fields: [driverId], references: [id])
  shipments    Shipment[]
}

model Order {
  id           String     @id @default(cuid())
  orderNo      String     @unique
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id])
  origin       String
  destination  String
  weight       Float      // tons
  description  String?
  status       String     @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | DELIVERED | CANCELLED
  totalCost    Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  shipment     Shipment?
}

model Shipment {
  id             String    @id @default(cuid())
  trackingNo     String    @unique
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  driverId       String?
  driver         Driver?   @relation(fields: [driverId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id])
  status         String    @default("PENDING") // PENDING | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | FAILED
  origin         String
  destination    String
  estimatedDist  Float?    // km
  estimatedTime  Int?      // minutes
  routeWaypoints String?   // JSON string of waypoints
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  events         ShipmentEvent[]
}

model ShipmentEvent {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id])
  status      String
  note        String?
  location    String?
  createdAt   DateTime @default(now())
}

// ── AI layer ────────────────────────────────────────────────────────────────
// JARVIS assistant + the agents it can forge. See src/ai/.

model Agent {
  id           String     @id @default(cuid())
  name         String     @unique
  role         String     // one-line job description, shown on the roster
  systemPrompt String     // the agent's standing orders
  tools        String     @default("[]") // JSON array of tool names it may call
  model        String     @default("claude-opus-5")
  status       String     @default("STANDBY") // STANDBY | ACTIVE | RETIRED
  autonomy     String     @default("READ_ONLY") // READ_ONLY | COMMAND
  createdBy    String     @default("OPERATOR") // OPERATOR | JARVIS
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  runs         AgentRun[]
}

model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  input       String
  output      String?
  toolCalls   String    @default("[]") // JSON array of {name, input, ok}
  status      String    @default("RUNNING") // RUNNING | COMPLETE | FAILED
  error       String?
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New session")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // user | assistant
  content   String
  toolCalls String      @default("[]") // JSON array of {name, input, ok}
  createdAt DateTime    @default(now())
}
